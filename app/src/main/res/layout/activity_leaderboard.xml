                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold" />
        </TableRow>
        <TableRow>
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="1" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:text="Obecnie te dane to jest" />
