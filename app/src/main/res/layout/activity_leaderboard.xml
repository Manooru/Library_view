            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:text="98" />
        </TableRow>
        <TableRow>
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="3" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:text="Krzysztof" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:text="77" />
        </TableRow>
        <TableRow>
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="4" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:text="Magdalena" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:text="150" />
        </TableRow>
        <TableRow>
